# ─── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:4000

# ─── Database ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/stocksense

# ─── JWT ───────────────────────────────────────────────────────────────────────
# Generate strong random strings, e.g.:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

JWT_ACCESS_SECRET=replace_with_strong_random_secret
JWT_REFRESH_SECRET=replace_with_different_strong_random_secret
JWT_RESET_SECRET=replace_with_another_strong_random_secret

# Token lifetimes — use Xd (days), Xh (hours), Xm (minutes)
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
JWT_RESET_EXPIRES_IN=5m

# ─── Cookies ───────────────────────────────────────────────────────────────────
# Set to your actual domain in production (e.g. api.stocksense.com)
COOKIE_DOMAIN=localhost

# ─── Email ─────────────────────────────────────────────────────────────────────
# In development the email service stubs to console — no SMTP needed.
# In production, fill in your SMTP provider credentials.
EMAIL_FROM=noreply@stocksense.local
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
